<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- 大地图飞行点图钉：继承暴雪自己的飞行点图钉模板，外观与原生一致；单独的模板名让它有独立的对象池，
         不和暴雪自带的飞行点图层互相清除。由 Modules/WorldMap.lua 的数据提供者放置。 -->
    <Frame name="WowHandbookFlightPinTemplate" inherits="FlightPointPinTemplate" virtual="true"/>
    <!-- 副本入口与灵魂医者图钉：客户端没有可继承的基础图钉模板，创建时混入暴雪地图的基础图钉方法
         （MapCanvasPinMixin，地图框架放置、释放图钉时要用），图标、悬停与点击在 Modules/WorldMap.lua 里设置。 -->
    <Frame name="WowHandbookDungeonPinTemplate" hidden="true" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, MapCanvasPinMixin)
            </OnLoad>
        </Scripts>
    </Frame>
    <Frame name="WowHandbookGraveyardPinTemplate" hidden="true" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, MapCanvasPinMixin)
            </OnLoad>
        </Scripts>
    </Frame>
    <!-- 专业训练师图钉：同样混入基础图钉方法，图标（专业图标）与提示在 Modules/WorldMap.lua 里设置 -->
    <Frame name="WowHandbookTrainerPinTemplate" hidden="true" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, MapCanvasPinMixin)
            </OnLoad>
        </Scripts>
    </Frame>
    <!-- 职业训练师图钉：同样混入基础图钉方法，图标（职业图标）与提示在 Modules/WorldMap.lua 里设置 -->
    <Frame name="WowHandbookClassTrainerPinTemplate" hidden="true" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, MapCanvasPinMixin)
            </OnLoad>
        </Scripts>
    </Frame>
    <!-- 草药与矿点图钉：同样混入基础图钉方法，图标（采到的物品）与提示在 Modules/WorldMap.lua 里设置 -->
    <Frame name="WowHandbookGatherPinTemplate" hidden="true" enableMouse="true" virtual="true">
        <Scripts>
            <OnLoad>
                Mixin(self, MapCanvasPinMixin)
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>
